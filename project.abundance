          ],
          "interpreterVersion": 1,
          "code": "/**\n * TR8 thread for cutting a nut: 8 mm trapezoidal, 2 mm pitch, multi-start.\n * The lobed cross-section (crest, flank, root, flank per start) is\n * extruded with one full twist per lead, giving a true helicoid as a\n * single solid. clearance enlarges the profile radially for printing.\n * A left-hand thread is the right-hand one mirrored.\n */\nfunction run(\n  length: number = 64, // mm\n  majorDiameter: number = 8, // mm\n  clearance: number = 0.2, // mm, added to the radius\n  pitch: number = 2, // mm\n  starts: number = 4,\n  threadDepth: number = 1.25, // mm\n  leftHand: boolean = false,\n): Assembly {\n  const lead = pitch * starts;\n  const rMajor = majorDiameter / 2 + clearance;\n  const rMinor = rMajor - threadDepth;\n\n  const crest = 0.366 * pitch;\n  const flank = threadDepth * Math.tan((15 * Math.PI) / 180);\n  const root = pitch - crest - 2 * flank;\n\n  const toAngle = (z: number) => (2 * Math.PI * z) / lead;\n  const polar = (r: number, a: number): [number, number] => [r * Math.cos(a), r * Math.sin(a)];\n\n  let a = 0;\n  let pen = replicad.draw(polar(rMajor, a));\n  for (let i = 0; i < starts; i++) {\n    const segment = (r0: number, r1: number, width: number) => {\n      const end = a + toAngle(width);\n      pen = pen.threePointsArcTo(polar(r1, end), polar((r0 + r1) / 2, (a + end) / 2));\n      a = end;\n    };\n    segment(rMajor, rMajor, crest);\n    segment(rMajor, rMinor, flank);\n    segment(rMinor, rMinor, root);\n    if (i < starts - 1) segment(rMinor, rMajor, flank);\n  }\n  const end = 2 * Math.PI;\n  pen = pen.threePointsArcTo(polar(rMajor, end), polar((rMinor + rMajor) / 2, (a + end) / 2));\n\n  let screw = pen\n    .close()\n    .sketchOnPlane(\"XY\")\n    .extrude(length, { twistAngle: (360 * length) / lead });\n  if (leftHand) screw = screw.mirror(\"YZ\");\n\n  return new Assembly({ geometry: screw, color: \"#B8BCC2\", tags: [\"thread cutter\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * TR8 thread for cutting a nut: 8 mm trapezoidal, 2 mm pitch, multi-start.\n * The lobed cross-section (crest, flank, root, flank per start) is\n * extruded with one full twist per lead, giving a true helicoid as a\n * single solid. clearance enlarges the profile radially for printing.\n * A left-hand thread is the right-hand one mirrored.\n */\nfunction run(length = 64, // mm\nmajorDiameter = 8, // mm\nclearance = 0.2, // mm, added to the radius\npitch = 2, // mm\nstarts = 4, threadDepth = 1.25, // mm\nleftHand = false) {\n    const lead = pitch * starts;\n    const rMajor = majorDiameter / 2 + clearance;\n    const rMinor = rMajor - threadDepth;\n    const crest = 0.366 * pitch;\n    const flank = threadDepth * Math.tan((15 * Math.PI) / 180);\n    const root = pitch - crest - 2 * flank;\n    const toAngle = (z) => (2 * Math.PI * z) / lead;\n    const polar = (r, a) => [r * Math.cos(a), r * Math.sin(a)];\n    let a = 0;\n    let pen = replicad.draw(polar(rMajor, a));\n    for (let i = 0; i < starts; i++) {\n        const segment = (r0, r1, width) => {\n            const end = a + toAngle(width);\n            pen = pen.threePointsArcTo(polar(r1, end), polar((r0 + r1) / 2, (a + end) / 2));\n            a = end;\n        };\n        segment(rMajor, rMajor, crest);\n        segment(rMajor, rMinor, flank);\n        segment(rMinor, rMinor, root);\n        if (i < starts - 1)\n            segment(rMinor, rMajor, flank);\n    }\n    const end = 2 * Math.PI;\n    pen = pen.threePointsArcTo(polar(rMajor, end), polar((rMinor + rMajor) / 2, (a + end) / 2));\n    let screw = pen\n        .close()\n        .sketchOnPlane(\"XY\")\n        .extrude(length, { twistAngle: (360 * length) / lead });\n    if (leftHand)\n        screw = screw.mirror(\"YZ\");\n    return new Assembly({ geometry: screw, color: \"#B8BCC2\", tags: [\"thread cutter\"] });\n}\n"
        },
