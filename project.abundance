              "interpreterVersion": 1,
              "code": "/**\n * Double-thread TR8 leadscrew: the space shared by a right-hand and a\n * left-hand 4-start trapezoidal thread, so both a CW and a CCW nut\n * thread onto it.\n *\n * Each thread is its lobed cross-section (crest, flank, root, flank per\n * start) extruded with one full twist per lead. Intersecting two\n * helicoids is very slow and gets much slower with length, but the result\n * repeats exactly every pitch, so only one pitch-long slice is intersected\n * and copies are stacked. The copies are returned as ONE compound part:\n * as separate parts Abundance would cut each against its neighbour and\n * Export would fuse them all, both very slow on these twisted surfaces.\n */\nfunction run(\n  length: number = 110, // mm, rounded to whole pitches\n  majorDiameter: number = 8, // mm\n  pitch: number = 2, // mm\n  starts: number = 4,\n  threadDepth: number = 1.25, // mm, crest to root\n  color: string = \"#B8BCC2\",\n): Assembly {\n  const lead = pitch * starts;\n  const rMajor = majorDiameter / 2;\n  const rMinor = rMajor - threadDepth;\n\n  const crest = 0.366 * pitch; // ISO 2904 crest width\n  const flank = threadDepth * Math.tan((15 * Math.PI) / 180);\n  const root = pitch - crest - 2 * flank;\n\n  const toAngle = (z: number) => (2 * Math.PI * z) / lead;\n  const polar = (r: number, a: number): [number, number] => [r * Math.cos(a), r * Math.sin(a)];\n\n  // One pitch-long slice of the right-hand thread\n  const thread = () => {\n    let a = 0;\n    let pen = replicad.draw(polar(rMajor, a));\n    for (let i = 0; i < starts; i++) {\n      const segment = (r0: number, r1: number, width: number) => {\n        const end = a + toAngle(width);\n        pen = pen.threePointsArcTo(polar(r1, end), polar((r0 + r1) / 2, (a + end) / 2));\n        a = end;\n      };\n      segment(rMajor, rMajor, crest);\n      segment(rMajor, rMinor, flank);\n      segment(rMinor, rMinor, root);\n      if (i < starts - 1) segment(rMinor, rMajor, flank);\n    }\n    const end = 2 * Math.PI;\n    pen = pen.threePointsArcTo(polar(rMajor, end), polar((rMinor + rMajor) / 2, (a + end) / 2));\n    return pen\n      .close()\n      .sketchOnPlane(\"XY\")\n      .extrude(pitch, { twistAngle: (360 * pitch) / lead });\n  };\n\n  const right = thread();\n  const left = thread().mirror(\"YZ\");\n  const slice = right.intersect(left);\n\n  const count = Math.max(1, Math.round(length / pitch));\n  const copies = [];\n  for (let i = 0; i < count; i++) {\n    copies.push(slice.clone().translate(0, 0, pitch * i));\n  }\n\n  return new Assembly({\n    geometry: replicad.makeCompound(copies),\n    color,\n    tags: [\"leadscrew\"],\n  });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Double-thread TR8 leadscrew: the space shared by a right-hand and a\n * left-hand 4-start trapezoidal thread, so both a CW and a CCW nut\n * thread onto it.\n *\n * Each thread is its lobed cross-section (crest, flank, root, flank per\n * start) extruded with one full twist per lead. Intersecting two\n * helicoids is very slow and gets much slower with length, but the result\n * repeats exactly every pitch, so only one pitch-long slice is intersected\n * and copies are stacked. The copies are returned as ONE compound part:\n * as separate parts Abundance would cut each against its neighbour and\n * Export would fuse them all, both very slow on these twisted surfaces.\n */\nfunction run(length = 110, // mm, rounded to whole pitches\nmajorDiameter = 8, // mm\npitch = 2, // mm\nstarts = 4, threadDepth = 1.25, // mm, crest to root\ncolor = \"#B8BCC2\") {\n    const lead = pitch * starts;\n    const rMajor = majorDiameter / 2;\n    const rMinor = rMajor - threadDepth;\n    const crest = 0.366 * pitch; // ISO 2904 crest width\n    const flank = threadDepth * Math.tan((15 * Math.PI) / 180);\n    const root = pitch - crest - 2 * flank;\n    const toAngle = (z) => (2 * Math.PI * z) / lead;\n    const polar = (r, a) => [r * Math.cos(a), r * Math.sin(a)];\n    // One pitch-long slice of the right-hand thread\n    const thread = () => {\n        let a = 0;\n        let pen = replicad.draw(polar(rMajor, a));\n        for (let i = 0; i < starts; i++) {\n            const segment = (r0, r1, width) => {\n                const end = a + toAngle(width);\n                pen = pen.threePointsArcTo(polar(r1, end), polar((r0 + r1) / 2, (a + end) / 2));\n                a = end;\n            };\n            segment(rMajor, rMajor, crest);\n            segment(rMajor, rMinor, flank);\n            segment(rMinor, rMinor, root);\n            if (i < starts - 1)\n                segment(rMinor, rMajor, flank);\n        }\n        const end = 2 * Math.PI;\n        pen = pen.threePointsArcTo(polar(rMajor, end), polar((rMinor + rMajor) / 2, (a + end) / 2));\n        return pen\n            .close()\n            .sketchOnPlane(\"XY\")\n            .extrude(pitch, { twistAngle: (360 * pitch) / lead });\n    };\n    const right = thread();\n    const left = thread().mirror(\"YZ\");\n    const slice = right.intersect(left);\n    const count = Math.max(1, Math.round(length / pitch));\n    const copies = [];\n    for (let i = 0; i < count; i++) {\n        copies.push(slice.clone().translate(0, 0, pitch * i));\n    }\n    return new Assembly({\n        geometry: replicad.makeCompound(copies),\n        color,\n        tags: [\"leadscrew\"],\n    });\n}\n"
            }
